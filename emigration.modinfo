<?xml version="1.0" encoding="utf-8"?>
<Mod id="emigration" version="1" xmlns="ModInfo">
    <Properties>
        <Name>LOC_MOD_EMIGRATION_NAME</Name>
        <Description>LOC_MOD_EMIGRATION_DESCRIPTION</Description>
        <Authors>Tower</Authors>
        <SpecialThanks>killmeplease, Tomahawk, Mk Z, and Tim_The_Texan's "Emigration" mod for Civilization V (the Prosperity model this adapts).</SpecialThanks>
        <Package>EmigrationMod</Package>
        <PackageSortIndex>1000</PackageSortIndex>
        <Version>4.0.3</Version>
    </Properties>
    <Dependencies>
        <Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME" />
    </Dependencies>
    <ActionCriteria>
        <Criteria id="always">
            <AlwaysMet></AlwaysMet>
        </Criteria>
        <Criteria id="antiquity-age-current">
            <AgeInUse>AGE_ANTIQUITY</AgeInUse>
        </Criteria>
        <Criteria id="exploration-age-current">
            <AgeInUse>AGE_EXPLORATION</AgeInUse>
        </Criteria>
        <Criteria id="modern-age-current">
            <AgeInUse>AGE_MODERN</AgeInUse>
        </Criteria>
        <!-- Civilopedia History Corrections: the history text on six independent-power pages from Civilopedia
             Expanded: Independents. Each group needs that mod in use, so without it the game's pages are left as
             they are. The text in history-corrections/ is a copy kept in step with the standalone mod. -->
        <Criteria id="history-corrections-antiquity">
            <ModInUse>maple-leaves-civilopedia-expanded</ModInUse>
            <AgeInUse>AGE_ANTIQUITY</AgeInUse>
        </Criteria>
        <Criteria id="history-corrections-exploration">
            <ModInUse>maple-leaves-civilopedia-expanded</ModInUse>
            <AgeInUse>AGE_EXPLORATION</AgeInUse>
        </Criteria>
        <Criteria id="history-corrections-exploration-sengoku">
            <ModInUse>maple-leaves-civilopedia-expanded</ModInUse>
            <AgeInUse>AGE_EXPLORATION</AgeInUse>
            <ModInUse>sengoku</ModInUse>
        </Criteria>
        <Criteria id="history-corrections-exploration-mlcs">
            <ModInUse>maple-leaves-civilopedia-expanded</ModInUse>
            <AgeInUse>AGE_EXPLORATION</AgeInUse>
            <ModInUse>ml-city-states-expanded</ModInUse>
        </Criteria>
    </ActionCriteria>
    <ActionGroups>
        <ActionGroup id="emigration-shell" scope="shell" criteria="always">
            <Properties>
                <LoadOrder>60</LoadOrder>
            </Properties>
            <Actions>
                <UpdateText>
                    <Item>text/en_us/ModText.xml</Item>
                    <Item locale="de_DE">text/de_de/ModText.xml</Item>
                    <Item locale="es_ES">text/es_es/ModText.xml</Item>
                    <Item locale="fr_FR">text/fr_fr/ModText.xml</Item>
                    <Item locale="it_IT">text/it_it/ModText.xml</Item>
                    <Item locale="ja_JP">text/ja_jp/ModText.xml</Item>
                    <Item locale="ko_KR">text/ko_kr/ModText.xml</Item>
                    <Item locale="pl_PL">text/pl_pl/ModText.xml</Item>
                    <Item locale="pt_BR">text/pt_br/ModText.xml</Item>
                    <Item locale="ru_RU">text/ru_ru/ModText.xml</Item>
                    <Item locale="zh_Hans_CN">text/zh_hans_cn/ModText.xml</Item>
                    <Item locale="zh_Hant_HK">text/zh_hant_hk/ModText.xml</Item>
                </UpdateText>
                <UIScripts>
                    <!-- Tower Settings Keeper: listed first, imports nothing, so it runs before anything reads storage. -->
                    <Item>ui/settings-keeper.js</Item>
                    <Item>ui/emigration-config.js</Item>
                    <Item>ui/emigration-cache-reset.js</Item>
                    <Item>ui/emigration-tunables.js</Item>
                    <Item>ui/emigration-settings.js</Item>
                    <Item>ui/emigration-options.js</Item>
                </UIScripts>
                <ImportFiles>
                    <!-- Imported (side-effect) by emigration-options.js to register the
                         Advanced tunables sub-window; must be importable in the shell too. -->
                    <Item>ui/options/emigration-advanced-editor.js</Item>
                    <!-- Shared localization helper, imported by the Advanced editor (and others). -->
                    <Item>ui/emigration-loc.js</Item>
                </ImportFiles>
            </Actions>
        </ActionGroup>
        <ActionGroup id="emigration-game" scope="game" criteria="always">
            <Properties>
                <LoadOrder>60</LoadOrder>
            </Properties>
            <Actions>
                <UpdateText>
                    <Item>text/en_us/ModText.xml</Item>
                    <Item>text/en_us/EnclaveText.xml</Item>
                    <Item>text/en_us/PediaText.xml</Item>
                    <Item>text/en_us/PediaVoicesText.xml</Item>
                    <Item locale="de_DE">text/de_de/ModText.xml</Item>
                    <Item locale="es_ES">text/es_es/ModText.xml</Item>
                    <Item locale="fr_FR">text/fr_fr/ModText.xml</Item>
                    <Item locale="it_IT">text/it_it/ModText.xml</Item>
                    <Item locale="ja_JP">text/ja_jp/ModText.xml</Item>
                    <Item locale="ko_KR">text/ko_kr/ModText.xml</Item>
                    <Item locale="pl_PL">text/pl_pl/ModText.xml</Item>
                    <Item locale="pt_BR">text/pt_br/ModText.xml</Item>
                    <Item locale="ru_RU">text/ru_ru/ModText.xml</Item>
                    <Item locale="zh_Hans_CN">text/zh_hans_cn/ModText.xml</Item>
                    <Item locale="zh_Hant_HK">text/zh_hant_hk/ModText.xml</Item>
                </UpdateText>
                <UIScripts>
                    <!-- Tower Settings Keeper: listed first, imports nothing, so it runs before anything reads storage. -->
                    <Item>ui/settings-keeper.js</Item>
                    <Item>ui/emigration-main.js</Item>
                    <Item>ui/emigration-origins-diag.js</Item>
                    <Item>ui/emigration-selftest.js</Item>
                    <Item>ui/emigration-prosperity-lens.js</Item>
                    <Item>ui/emigration-prosperity-tooltip.js</Item>
                    <Item>ui/emigration-ethnicity-lens.js</Item>
                    <Item>ui/emigration-ethnicity-tooltip.js</Item>
                    <Item>ui/emigration-enclave-markers.js</Item>
                    <Item>ui/emigration-enclave-tooltip.js</Item>
                    <Item>ui/emigration-settings.js</Item>
                    <Item>ui/emigration-options.js</Item>
                </UIScripts>
                <ImportFiles>
                    <Item>ui/emigration-config.js</Item>
                    <Item>ui/emigration-cache-reset.js</Item>
                    <Item>ui/emigration-loc.js</Item>
                    <Item>ui/emigration-causes.js</Item>
                    <Item>ui/emigration-tunables.js</Item>
                    <Item>ui/emigration-population.js</Item>
                    <Item>ui/emigration-polity.js</Item>
                    <Item>ui/emigration-built.js</Item>
                    <Item>ui/emigration-cities.js</Item>
                    <Item>ui/emigration-prosperity.js</Item>
                    <Item>ui/emigration-geography.js</Item>
                    <Item>ui/emigration-violence.js</Item>
                    <Item>ui/emigration-disasters.js</Item>
                    <Item>ui/emigration-civ-tuning.js</Item>
                    <Item>ui/emigration-civ-roster.js</Item>
                    <Item>ui/emigration-effects.js</Item>
                    <Item>ui/emigration-damage-age.js</Item>
                    <Item>ui/emigration-departure-tile.js</Item>
                    <Item>ui/emigration-plot-cleanup.js</Item>
                    <Item>ui/emigration-arrival-placement.js</Item>
                    <Item>ui/emigration-enclave-place.js</Item>
                    <Item>ui/emigration-enclave-skins.js</Item>
                    <Item>ui/emigration-enclave-yields.js</Item>
                    <Item>ui/emigration-war.js</Item>
                    <Item>ui/emigration-combat.js</Item>
                    <Item>ui/emigration-combat-events.js</Item>
                    <Item>ui/emigration-event-attribution.js</Item>
                    <Item>ui/emigration-borders.js</Item>
                    <Item>ui/emigration-naming.js</Item>
                    <Item>ui/emigration-feedback.js</Item>
                    <Item>ui/emigration-events.js</Item>
                    <Item>ui/emigration-migration-stats.js</Item>
                    <Item>ui/emigration-city-net.js</Item>
                    <Item>ui/emigration-internal-tally.js</Item>
                    <Item>ui/emigration-stats-schema.js</Item>
                    <Item>ui/emigration-flow-history.js</Item>
                    <Item>ui/emigration-telemetry.js</Item>
                    <Item>ui/emigration-composition.js</Item>
                    <Item>ui/emigration-governance.js</Item>
                    <Item>ui/emigration-plot-tooltip-suppress.js</Item>
                    <Item>ui/emigration-lens-hover-panel.js</Item>
                    <Item>ui/emigration-enclave-tooltip-data.js</Item>
                    <Item>ui/emigration-tile-score.js</Item>
                    <Item>ui/emigration-city-readout-data.js</Item>
                    <Item>ui/emigration-city-readout.js</Item>
                    <Item>ui/emigration-city-panel-data.js</Item>
                    <Item>ui/emigration-city-panel.js</Item>
                    <Item>ui/emigration-enclave-pacing.js</Item>
                    <Item>ui/emigration-snapshot-reminder.js</Item>
                    <Item>ui/emigration-views.js</Item>
                    <Item>ui/emigration-network-viz.js</Item>
                    <Item>ui/emigration-network-fit.js</Item>
                    <Item>ui/emigration-civ-colors.js</Item>
                    <Item>ui/emigration-network-sim.js</Item>
                    <Item>ui/emigration-network-paint.js</Item>
                    <Item>ui/emigration-network-flow-arrows.js</Item>
                    <Item>ui/emigration-network-dots.js</Item>
                    <Item>ui/emigration-timeline-events.js</Item>
                    <Item>ui/emigration-network-timeline.js</Item>
                    <Item>ui/emigration-network-interact.js</Item>
                    <Item>ui/emigration-pies.js</Item>
                    <Item>ui/emigration-city-flows.js</Item>
                    <Item>ui/emigration-diversity.js</Item>
                    <Item>ui/emigration-detail-views.js</Item>
                    <Item>ui/emigration-ledger-view.js</Item>
                    <Item>ui/emigration-demo-data.js</Item>
                    <Item>ui/emigration-window.js</Item>
                    <Item>ui/emigration-window-settlements.js</Item>
                    <Item>ui/emigration-screen.js</Item>
                    <Item>ui/emigration-screen.html</Item>
                    <Item>ui/emigration-screen.css</Item>
                    <Item>ui/emigration-selftest-checks.js</Item>
                    <Item>ui/emigration-selftest.html</Item>
                    <Item>ui/emigration-selftest.css</Item>
                    <Item>ui/emigration-density.js</Item>
                    <Item>ui/emigration-dock-decorator.js</Item>
                    <Item>ui/emigration-migration-page.js</Item>
                    <Item>ui/emigration-engine.js</Item>
                    <Item>ui/emigration-outlet-death.js</Item>
                    <Item>ui/emigration-game-speed.js</Item>
                    <Item>ui/emigration-notifications.js</Item>
                    <Item>ui/emigration-notifications-view.js</Item>
                    <!-- The game's notification train as the surface for the mod's notices. -->
                    <Item>ui/emigration-train.js</Item>
                    <Item>ui/emigration-raid.js</Item>
                    <!-- Submodules split out of the files above (engine→pull/state/
                         migration-records/consequences/arrivals,
                         effects→dividend/migrant-units, migration-stats→demographics,
                         main→log/report, violence→violence-signals). Imported by their
                         parents, so they must be registered to resolve at load. -->
                    <Item>ui/emigration-pull.js</Item>
                    <Item>ui/emigration-explain.js</Item>
                    <Item>ui/emigration-explain-view.js</Item>
                    <Item>ui/emigration-move-reasons.js</Item>
                    <Item>ui/emigration-state.js</Item>
                    <Item>ui/emigration-migration-records.js</Item>
                    <Item>ui/emigration-consequences.js</Item>
                    <Item>ui/emigration-arrivals.js</Item>
                    <Item>ui/emigration-inbound.js</Item>
                    <Item>ui/emigration-refugee-pool.js</Item>
                    <Item>ui/emigration-refugee-staging.js</Item>
                    <Item>ui/emigration-refugee-burden.js</Item>
                    <Item>ui/emigration-dividend.js</Item>
                    <Item>ui/emigration-migrant-units.js</Item>
                    <Item>ui/emigration-demographics.js</Item>
                    <Item>ui/emigration-log.js</Item>
                    <Item>ui/emigration-report.js</Item>
                    <Item>ui/emigration-violence-signals.js</Item>
                    <Item>ui/emigration-violence-audit.js</Item>
                    <!-- Per-tile ethnic-mosaic: the pure distribution model + the shared tiles module
                         (engine reads + per-turn cache), imported by the ethnicity lens and its tooltip. -->
                    <Item>ui/emigration-ethnicity-distribution.js</Item>
                    <Item>ui/emigration-ethnicity-tiles.js</Item>
                    <!-- The lens's tile color: the share-weighted blend of origin colors (pure, no imports). -->
                    <Item>ui/emigration-ethnicity-colour.js</Item>
                    <!-- Migration Chronicle: prose engine + persistent store + diaspora detection.
                         Entries surface in the Notifications tab (v1.6.0 folded the Chronicle in). -->
                    <Item>ui/emigration-narrative.js</Item>
                    <Item>ui/emigration-chronicle.js</Item>
                    <Item>ui/emigration-diaspora.js</Item>
                    <!-- Truthful "quarter" naming for diaspora lines: real city features (city-features,
                         engine reads) resolved to an always-true phrase (quarters, pure). -->
                    <Item>ui/emigration-city-features.js</Item>
                    <Item>ui/emigration-quarter-phrases.js</Item>
                    <!-- Return migration (homeland recovery): moves real population back home. -->
                    <Item>ui/emigration-return.js</Item>
                    <!-- Who has come home, taken off the all-game flow ledger by call-home. -->
                    <Item>ui/emigration-returned.js</Item>
                    <Item>ui/emigration-lost-tiles.js</Item>
                    <!-- What would stop people leaving (the readout's fix line); the AI's difficulty discount; the
                         other civilizations' stance changes as notices. -->
                    <Item>ui/emigration-tab-switches.js</Item>
                    <Item>ui/emigration-prescribe.js</Item>
                    <Item>ui/emigration-ai-difficulty.js</Item>
                    <Item>ui/emigration-ai-stance-notice.js</Item>
                    <Item>ui/emigration-call-home.js</Item>
                    <Item>ui/emigration-call-home-action.js</Item>
                    <Item>ui/emigration-call-home-ai.js</Item>
                    <!-- People displaced inside their civ go home on their own once home is calm. -->
                    <Item>ui/emigration-homecoming.js</Item>
                    <Item>ui/emigration-homecoming-split.js</Item>
                    <Item>ui/emigration-relief.js</Item>
                    <!-- The Displaced tab: where your people are, what a returnee is worth, the way home. -->
                    <Item>ui/emigration-displaced.js</Item>
                    <Item>ui/emigration-displaced-view.js</Item>
                    <Item>ui/emigration-hasten-ledger.js</Item>
                    <Item>ui/emigration-home-notice.js</Item>
                    <Item>ui/emigration-settlement-model.js</Item>
                    <Item>ui/emigration-settlement-card.js</Item>
                    <Item>ui/emigration-settlement-ledger.js</Item>
                    <Item>ui/emigration-forecast.js</Item>
                    <Item>ui/emigration-first-loss.js</Item>
                    <Item>ui/emigration-intake-ai.js</Item>
                    <Item>ui/emigration-intake-upkeep.js</Item>
                    <Item>ui/emigration-settlements-section.js</Item>
                    <Item>ui/emigration-quarter-decision.js</Item>
                    <Item>ui/emigration-pass-signals.js</Item>
                    <Item>ui/emigration-ai-host.js</Item>
                    <Item>ui/emigration-call-home-view.js</Item>
                    <!-- Refugee dilemmas: rare narrative decision + its trigger logic. The decision
                         renders in the game's own native dialog (DialogBoxManager), so there is no
                         mod-owned html/css panel. -->
                    <Item>ui/emigration-dilemma.js</Item>
                    <Item>ui/emigration-dilemma-view.js</Item>
                    <!-- Refugee and migrant epigraphs by origin civilization, in the displaced people's
                         own voice (pure registry + pick; used by the dilemma and arrivals). -->
                    <Item>ui/emigration-displaced-quotes.js</Item>
                    <Item>ui/emigration-return-quotes.js</Item>
                    <!-- Cultural Quarters: an established diaspora becomes a persistent, player-shaped
                         district. Per-civ bonus registry (origin-specific trade-off options) + option
                         catalogue + per-tile persistent store + the decision/change-of-hands/contested
                         runtime (reuses the dilemma modal). -->
                    <Item>ui/emigration-quarter-bonuses.js</Item>
                    <Item>ui/emigration-quarter-registry.js</Item>
                    <Item>ui/emigration-quarter-state.js</Item>
                    <Item>ui/emigration-quarter-hosts.js</Item>
                    <Item>ui/emigration-enclave-stage.js</Item>
                    <Item>ui/emigration-enclave-stage-read.js</Item>
                    <Item>ui/emigration-treatment.js</Item>
                    <Item>ui/emigration-consular.js</Item>
                    <Item>ui/emigration-partisans.js</Item>
                    <!-- What a recognized enclave's stance pays once, sized from the host's income. -->
                    <Item>ui/emigration-stance-payout.js</Item>
                    <Item>ui/emigration-quarter.js</Item>
                    <!-- Advanced tunables sub-window, imported by emigration-options.js. -->
                    <Item>ui/options/emigration-advanced-editor.js</Item>
                    <!-- Dock-button icon (CSS mask asset, referenced via fs://game/emigration/...). -->
                    <Item>images/emigration-dock-icon.svg</Item>
                </ImportFiles>
            </Actions>
        </ActionGroup>
        <ActionGroup id="emigration-shared-data" scope="game" criteria="always">
            <Properties>
                <LoadOrder>50</LoadOrder>
            </Properties>
            <Actions>
                <UpdateDatabase>
                    <Item>data/emigration-civilopedia.xml</Item>
                    <Item>data/emigration-civilopedia-voices.xml</Item>
                    <Item>data/emigration-policies-gameeffects.xml</Item>
                    <Item>data/emigration-enclave-improvements.xml</Item>
                    <Item>data/emigration-enclave-village.xml</Item>
                    <Item>data/emigration-enclave-village-db.xml</Item>
                    <!-- The notification types ui/emigration-train.js raises in the game's notification train. -->
                    <Item>data/emigration-notifications.xml</Item>
                    <!-- The old People who left buildings, kept so first-4.0.0 saves load (ui/emigration-relief.js). -->
                    <Item>data/emigration-relief.sql</Item>
                </UpdateDatabase>
                <UpdateIcons>
                    <Item>data/emigration-policy-icons.xml</Item>
                    <Item>data/emigration-enclave-icons.xml</Item>
                    <Item>data/emigration-notification-icons.xml</Item>
                </UpdateIcons>
            </Actions>
        </ActionGroup>
        <ActionGroup id="emigration-ai-strategy" scope="game" criteria="always">
            <Properties>
                <LoadOrder>50</LoadOrder>
            </Properties>
            <Actions>
                <UpdateDatabase>
                    <!-- The AI's two city strategies: an earlier, gentler "keep them happy", and "hold your people". -->
                    <Item>data/emigration-ai-strategy.sql</Item>
                </UpdateDatabase>
            </Actions>
        </ActionGroup>
        <ActionGroup id="emigration-policies-aq" scope="game" criteria="antiquity-age-current">
            <Properties>
                <LoadOrder>50</LoadOrder>
            </Properties>
            <Actions>
                <UpdateDatabase>
                    <Item>data/emigration-policies-antiquity.xml</Item>
                </UpdateDatabase>
            </Actions>
        </ActionGroup>
        <ActionGroup id="emigration-policies-ex" scope="game" criteria="exploration-age-current">
            <Properties>
                <LoadOrder>50</LoadOrder>
            </Properties>
            <Actions>
                <UpdateDatabase>
                    <Item>data/emigration-policies-exploration.xml</Item>
                </UpdateDatabase>
            </Actions>
        </ActionGroup>
        <ActionGroup id="emigration-policies-mo" scope="game" criteria="modern-age-current">
            <Properties>
                <LoadOrder>50</LoadOrder>
            </Properties>
            <Actions>
                <UpdateDatabase>
                    <Item>data/emigration-policies-modern.xml</Item>
                </UpdateDatabase>
            </Actions>
        </ActionGroup>
        <!-- Civilopedia History Corrections, loaded at 1000 to come after Civilopedia Expanded's groups (10, 100
             and 210). Text only. -->
        <ActionGroup id="history-corrections-antiquity-text" scope="game" criteria="history-corrections-antiquity">
            <Properties>
                <LoadOrder>1000</LoadOrder>
            </Properties>
            <Actions>
                <UpdateText>
                    <Item>history-corrections/antiquity-text.xml</Item>
                </UpdateText>
            </Actions>
        </ActionGroup>
        <ActionGroup id="history-corrections-exploration-text" scope="game" criteria="history-corrections-exploration">
            <Properties>
                <LoadOrder>1000</LoadOrder>
            </Properties>
            <Actions>
                <UpdateText>
                    <Item>history-corrections/exploration-text.xml</Item>
                </UpdateText>
            </Actions>
        </ActionGroup>
        <ActionGroup id="history-corrections-exploration-sengoku-text" scope="game" criteria="history-corrections-exploration-sengoku">
            <Properties>
                <LoadOrder>1000</LoadOrder>
            </Properties>
            <Actions>
                <UpdateText>
                    <Item>history-corrections/exploration-sengoku-text.xml</Item>
                </UpdateText>
            </Actions>
        </ActionGroup>
        <ActionGroup id="history-corrections-exploration-mlcs-text" scope="game" criteria="history-corrections-exploration-mlcs">
            <Properties>
                <LoadOrder>1000</LoadOrder>
            </Properties>
            <Actions>
                <UpdateText>
                    <Item>history-corrections/exploration-mlcs-text.xml</Item>
                </UpdateText>
            </Actions>
        </ActionGroup>
    </ActionGroups>
    <LocalizedText>
        <File>text/en_us/ModText.xml</File>
    </LocalizedText>
</Mod>
