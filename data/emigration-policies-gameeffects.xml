<?xml version="1.0" encoding="utf-8"?>
<!--
  Native Influence (YIELD_DIPLOMACY) modifiers for the border-policy cards, so the bonus/
  penalty is VISIBLE on the policy-selection card and applied as a real per-turn yield. The
  prior UI-VM approach (DiplomacyTreasury.changeDiplomacyBalance) was a hidden balance tweak
  that never showed in the yields breakdown. Pattern copied verbatim from the base game's
  TRADITION_ORATORY influence modifier (EFFECT_PLAYER_ADJUST_YIELD / COLLECTION_OWNER).

    PER-ERA values (Phase 1 of ../emigration-docs/immigration-interaction-plan.md): a border stance is a louder
  diplomatic statement in later ages. Open +1/+2/+3, Closed -2/-3/-4 across Antiquity /
  Exploration / Modern. Modifiers carry no age foreign key, so all six live in this always-loaded
  file; the per-age emigration-policies-<age>.xml TraditionModifiers each link the matching id.
  The immigration-% effect stays in ui/emigration-borders.js (a custom migration mechanic the
  engine can't express).
-->
<GameEffects xmlns="GameEffects">
    <!-- Unlinked in 3.6.2: no TraditionModifiers row points at these six any more. A card that grants the slot
         it sits in crashes the game natively during the AI turn (its policy planner slots and unslots cards and
         the slot count changes underneath it; seen 2026-10-17 on every End Turn of a turn-76 save, gone with the
         links removed). The definitions stay so a save made with 3.6.0 or 3.6.1 still finds every modifier id
         it holds. Never link them to the stance traditions again. -->
    <Modifier id="MOD_EMIG_STANCE_SLOT_OPEN_AQ" collection="COLLECTION_OWNER" effect="EFFECT_PLAYER_GRANT_TRADITION_SLOTS">
        <SubjectRequirements>
            <Requirement type="REQUIREMENT_PLAYER_HAS_ACTIVE_TRADITION" inverse="true">
                <Argument name="TraditionType">TRADITION_EMIG_CLOSED_BORDERS_ANTIQUITY</Argument>
            </Requirement>
        </SubjectRequirements>
        <Argument name="Amount">1</Argument>
        <Argument name="SlotType">POLICY_CULTURE_SLOT</Argument>
        <String context="Description">LOC_EMIG_POLICY_STANCE_SLOT_DESC</String>
    </Modifier>
    <Modifier id="MOD_EMIG_STANCE_SLOT_CLOSED_AQ" collection="COLLECTION_OWNER" effect="EFFECT_PLAYER_GRANT_TRADITION_SLOTS">
        <SubjectRequirements>
            <Requirement type="REQUIREMENT_PLAYER_HAS_ACTIVE_TRADITION" inverse="true">
                <Argument name="TraditionType">TRADITION_EMIG_OPEN_BORDERS_ANTIQUITY</Argument>
            </Requirement>
        </SubjectRequirements>
        <Argument name="Amount">1</Argument>
        <Argument name="SlotType">POLICY_CULTURE_SLOT</Argument>
        <String context="Description">LOC_EMIG_POLICY_STANCE_SLOT_DESC</String>
    </Modifier>
    <Modifier id="MOD_EMIG_STANCE_SLOT_OPEN_EX" collection="COLLECTION_OWNER" effect="EFFECT_PLAYER_GRANT_TRADITION_SLOTS">
        <SubjectRequirements>
            <Requirement type="REQUIREMENT_PLAYER_HAS_ACTIVE_TRADITION" inverse="true">
                <Argument name="TraditionType">TRADITION_EMIG_CLOSED_BORDERS_EXPLORATION</Argument>
            </Requirement>
        </SubjectRequirements>
        <Argument name="Amount">1</Argument>
        <Argument name="SlotType">POLICY_CULTURE_SLOT</Argument>
        <String context="Description">LOC_EMIG_POLICY_STANCE_SLOT_DESC</String>
    </Modifier>
    <Modifier id="MOD_EMIG_STANCE_SLOT_CLOSED_EX" collection="COLLECTION_OWNER" effect="EFFECT_PLAYER_GRANT_TRADITION_SLOTS">
        <SubjectRequirements>
            <Requirement type="REQUIREMENT_PLAYER_HAS_ACTIVE_TRADITION" inverse="true">
                <Argument name="TraditionType">TRADITION_EMIG_OPEN_BORDERS_EXPLORATION</Argument>
            </Requirement>
        </SubjectRequirements>
        <Argument name="Amount">1</Argument>
        <Argument name="SlotType">POLICY_CULTURE_SLOT</Argument>
        <String context="Description">LOC_EMIG_POLICY_STANCE_SLOT_DESC</String>
    </Modifier>
    <Modifier id="MOD_EMIG_STANCE_SLOT_OPEN_MO" collection="COLLECTION_OWNER" effect="EFFECT_PLAYER_GRANT_TRADITION_SLOTS">
        <SubjectRequirements>
            <Requirement type="REQUIREMENT_PLAYER_HAS_ACTIVE_TRADITION" inverse="true">
                <Argument name="TraditionType">TRADITION_EMIG_CLOSED_BORDERS_MODERN</Argument>
            </Requirement>
        </SubjectRequirements>
        <Argument name="Amount">1</Argument>
        <Argument name="SlotType">POLICY_CULTURE_SLOT</Argument>
        <String context="Description">LOC_EMIG_POLICY_STANCE_SLOT_DESC</String>
    </Modifier>
    <Modifier id="MOD_EMIG_STANCE_SLOT_CLOSED_MO" collection="COLLECTION_OWNER" effect="EFFECT_PLAYER_GRANT_TRADITION_SLOTS">
        <SubjectRequirements>
            <Requirement type="REQUIREMENT_PLAYER_HAS_ACTIVE_TRADITION" inverse="true">
                <Argument name="TraditionType">TRADITION_EMIG_OPEN_BORDERS_MODERN</Argument>
            </Requirement>
        </SubjectRequirements>
        <Argument name="Amount">1</Argument>
        <Argument name="SlotType">POLICY_CULTURE_SLOT</Argument>
        <String context="Description">LOC_EMIG_POLICY_STANCE_SLOT_DESC</String>
    </Modifier>

    <!-- Open / Pro-Immigration: +1 / +2 / +3 Influence. -->
    <Modifier id="MOD_EMIG_OPEN_BORDERS_INFLUENCE_AQ" collection="COLLECTION_OWNER" effect="EFFECT_PLAYER_ADJUST_YIELD">
        <Argument name="YieldType">YIELD_DIPLOMACY</Argument>
        <Argument name="Amount">1</Argument>
        <Argument name="Tooltip">LOC_EMIG_POLICY_OPEN_BORDERS_NAME</Argument>
        <String context="Description">LOC_EMIG_POLICY_OPEN_BORDERS_DESC</String>
    </Modifier>
    <Modifier id="MOD_EMIG_OPEN_BORDERS_INFLUENCE_EX" collection="COLLECTION_OWNER" effect="EFFECT_PLAYER_ADJUST_YIELD">
        <Argument name="YieldType">YIELD_DIPLOMACY</Argument>
        <Argument name="Amount">2</Argument>
        <Argument name="Tooltip">LOC_EMIG_POLICY_OPEN_BORDERS_NAME</Argument>
        <String context="Description">LOC_EMIG_POLICY_OPEN_BORDERS_DESC_EX</String>
    </Modifier>
    <Modifier id="MOD_EMIG_OPEN_BORDERS_INFLUENCE_MO" collection="COLLECTION_OWNER" effect="EFFECT_PLAYER_ADJUST_YIELD">
        <Argument name="YieldType">YIELD_DIPLOMACY</Argument>
        <Argument name="Amount">3</Argument>
        <Argument name="Tooltip">LOC_EMIG_POLICY_OPEN_BORDERS_NAME</Argument>
        <String context="Description">LOC_EMIG_POLICY_OPEN_BORDERS_DESC_MO</String>
    </Modifier>

    <!-- Closed / Anti-Immigration: -2 / -3 / -4 Influence. -->
    <Modifier id="MOD_EMIG_CLOSED_BORDERS_INFLUENCE_AQ" collection="COLLECTION_OWNER" effect="EFFECT_PLAYER_ADJUST_YIELD">
        <Argument name="YieldType">YIELD_DIPLOMACY</Argument>
        <Argument name="Amount">-2</Argument>
        <Argument name="Tooltip">LOC_EMIG_POLICY_CLOSED_BORDERS_NAME</Argument>
        <String context="Description">LOC_EMIG_POLICY_CLOSED_BORDERS_DESC</String>
    </Modifier>
    <Modifier id="MOD_EMIG_CLOSED_BORDERS_INFLUENCE_EX" collection="COLLECTION_OWNER" effect="EFFECT_PLAYER_ADJUST_YIELD">
        <Argument name="YieldType">YIELD_DIPLOMACY</Argument>
        <Argument name="Amount">-3</Argument>
        <Argument name="Tooltip">LOC_EMIG_POLICY_CLOSED_BORDERS_NAME</Argument>
        <String context="Description">LOC_EMIG_POLICY_CLOSED_BORDERS_DESC_EX</String>
    </Modifier>
    <Modifier id="MOD_EMIG_CLOSED_BORDERS_INFLUENCE_MO" collection="COLLECTION_OWNER" effect="EFFECT_PLAYER_ADJUST_YIELD">
        <Argument name="YieldType">YIELD_DIPLOMACY</Argument>
        <Argument name="Amount">-4</Argument>
        <Argument name="Tooltip">LOC_EMIG_POLICY_CLOSED_BORDERS_NAME</Argument>
        <String context="Description">LOC_EMIG_POLICY_CLOSED_BORDERS_DESC_MO</String>
    </Modifier>

    <!-- Pro-Immigration: the people the stance brings, as a yield the AI's planner can weigh. The planner values
         a card only by its native modifiers (there is no favour list for traditions), so the +50% immigration,
         the asylum tilt and the arrival dividend in the scripts were invisible to it and an AI only ever slotted
         this card for its Influence. Flat +2 / +2 / +3 Food per city by age (Antiquity raised from +1 on 2026-10-23: no AI took it at +1);
         it shows on the card and in the yield breakdown like any other modifier. -->
    <Modifier id="MOD_EMIG_OPEN_BORDERS_FOOD_AQ" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_YIELD">
        <SubjectRequirements>
            <Requirement type="REQUIREMENT_CITY_IS_CITY"/>
        </SubjectRequirements>
        <Argument name="Amount">2</Argument>
        <Argument name="YieldType">YIELD_FOOD</Argument>
        <Argument name="Tooltip">LOC_EMIG_POLICY_OPEN_BORDERS_NAME</Argument>
    </Modifier>
    <Modifier id="MOD_EMIG_OPEN_BORDERS_FOOD_EX" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_YIELD">
        <SubjectRequirements>
            <Requirement type="REQUIREMENT_CITY_IS_CITY"/>
        </SubjectRequirements>
        <Argument name="Amount">2</Argument>
        <Argument name="YieldType">YIELD_FOOD</Argument>
        <Argument name="Tooltip">LOC_EMIG_POLICY_OPEN_BORDERS_NAME</Argument>
    </Modifier>
    <Modifier id="MOD_EMIG_OPEN_BORDERS_FOOD_MO" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_YIELD">
        <SubjectRequirements>
            <Requirement type="REQUIREMENT_CITY_IS_CITY"/>
        </SubjectRequirements>
        <Argument name="Amount">3</Argument>
        <Argument name="YieldType">YIELD_FOOD</Argument>
        <Argument name="Tooltip">LOC_EMIG_POLICY_OPEN_BORDERS_NAME</Argument>
    </Modifier>

    <!-- Anti-Immigration autarky: a mobilized, self-sufficient home economy adds Production in every
         city (war-economy / closed-off-from-the-world theme), compensating for the Influence cost the
         stance carries. Flat +2 / +3 / +4 per city by age, applied to the owner's cities. -->
    <Modifier id="MOD_EMIG_CLOSED_BORDERS_PRODUCTION_AQ" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_YIELD">
        <SubjectRequirements>
            <Requirement type="REQUIREMENT_CITY_IS_CITY"/>
        </SubjectRequirements>
        <Argument name="Amount">2</Argument>
        <Argument name="YieldType">YIELD_PRODUCTION</Argument>
        <Argument name="Tooltip">LOC_EMIG_POLICY_CLOSED_BORDERS_NAME</Argument>
    </Modifier>
    <Modifier id="MOD_EMIG_CLOSED_BORDERS_PRODUCTION_EX" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_YIELD">
        <SubjectRequirements>
            <Requirement type="REQUIREMENT_CITY_IS_CITY"/>
        </SubjectRequirements>
        <Argument name="Amount">3</Argument>
        <Argument name="YieldType">YIELD_PRODUCTION</Argument>
        <Argument name="Tooltip">LOC_EMIG_POLICY_CLOSED_BORDERS_NAME</Argument>
    </Modifier>
    <Modifier id="MOD_EMIG_CLOSED_BORDERS_PRODUCTION_MO" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_YIELD">
        <SubjectRequirements>
            <Requirement type="REQUIREMENT_CITY_IS_CITY"/>
        </SubjectRequirements>
        <Argument name="Amount">4</Argument>
        <Argument name="YieldType">YIELD_PRODUCTION</Argument>
        <Argument name="Tooltip">LOC_EMIG_POLICY_CLOSED_BORDERS_NAME</Argument>
    </Modifier>

    <!-- Attraction cards: the yield scales with each city's population, the game's own
         EFFECT_CITY_ADJUST_YIELD_PER_POPULATION (as the Quipu tradition uses it), so every immigrant the card draws
         adds to it for as long as they stay, itemized in the city's yield breakdown. Replaced the carried dividend
         that faded 30% a turn (2026-10-25): players couldn't tell what "fading" meant. 1 per 5 Population in
         Exploration, 1 per 4 in Modern. Cultural Magnetism and Commercial Draw are retired but a save may still
         hold one, so they get the same shape. -->
    <Modifier id="MOD_EMIG_TALENT_YIELD_EX" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_YIELD_PER_POPULATION">
        <Argument name="YieldType">YIELD_SCIENCE</Argument>
        <Argument name="Amount">1</Argument>
        <Argument name="Divisor">5</Argument>
        <Argument name="Rural">true</Argument>
        <Argument name="Urban">true</Argument>
        <Argument name="Tooltip">LOC_EMIG_POLICY_TALENT_NAME</Argument>
        <String context="Description">LOC_EMIG_POLICY_TALENT_DESC</String>
    </Modifier>
    <Modifier id="MOD_EMIG_TALENT_YIELD_MO" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_YIELD_PER_POPULATION">
        <Argument name="YieldType">YIELD_SCIENCE</Argument>
        <Argument name="Amount">1</Argument>
        <Argument name="Divisor">4</Argument>
        <Argument name="Rural">true</Argument>
        <Argument name="Urban">true</Argument>
        <Argument name="Tooltip">LOC_EMIG_POLICY_TALENT_NAME</Argument>
        <String context="Description">LOC_EMIG_POLICY_TALENT_DESC_MO</String>
    </Modifier>
    <Modifier id="MOD_EMIG_CULTPULL_YIELD_EX" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_YIELD_PER_POPULATION">
        <Argument name="YieldType">YIELD_CULTURE</Argument>
        <Argument name="Amount">1</Argument>
        <Argument name="Divisor">5</Argument>
        <Argument name="Rural">true</Argument>
        <Argument name="Urban">true</Argument>
        <Argument name="Tooltip">LOC_EMIG_POLICY_CULTPULL_NAME</Argument>
        <String context="Description">LOC_EMIG_POLICY_CULTPULL_DESC</String>
    </Modifier>
    <Modifier id="MOD_EMIG_CULTPULL_YIELD_MO" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_YIELD_PER_POPULATION">
        <Argument name="YieldType">YIELD_CULTURE</Argument>
        <Argument name="Amount">1</Argument>
        <Argument name="Divisor">4</Argument>
        <Argument name="Rural">true</Argument>
        <Argument name="Urban">true</Argument>
        <Argument name="Tooltip">LOC_EMIG_POLICY_CULTPULL_NAME</Argument>
        <String context="Description">LOC_EMIG_POLICY_CULTPULL_DESC_MO</String>
    </Modifier>
    <Modifier id="MOD_EMIG_TRADEPULL_YIELD_EX" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_YIELD_PER_POPULATION">
        <Argument name="YieldType">YIELD_GOLD</Argument>
        <Argument name="Amount">1</Argument>
        <Argument name="Divisor">5</Argument>
        <Argument name="Rural">true</Argument>
        <Argument name="Urban">true</Argument>
        <Argument name="Tooltip">LOC_EMIG_POLICY_TRADEPULL_NAME</Argument>
        <String context="Description">LOC_EMIG_POLICY_TRADEPULL_DESC</String>
    </Modifier>
    <Modifier id="MOD_EMIG_TRADEPULL_YIELD_MO" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_YIELD_PER_POPULATION">
        <Argument name="YieldType">YIELD_GOLD</Argument>
        <Argument name="Amount">1</Argument>
        <Argument name="Divisor">4</Argument>
        <Argument name="Rural">true</Argument>
        <Argument name="Urban">true</Argument>
        <Argument name="Tooltip">LOC_EMIG_POLICY_TRADEPULL_NAME</Argument>
        <String context="Description">LOC_EMIG_POLICY_TRADEPULL_DESC_MO</String>
    </Modifier>

    <!-- Asylum cards (§4a): native Influence floor (+1 EX / +2 MO), plus +1 Culture in Modern
         (refugees enrich the receiver). The refugee-pull Tilt is the JS mechanic (engine.js). -->
    <Modifier id="MOD_EMIG_ASYLUM_INFLUENCE_EX" collection="COLLECTION_OWNER" effect="EFFECT_PLAYER_ADJUST_YIELD">
        <Argument name="YieldType">YIELD_DIPLOMACY</Argument>
        <Argument name="Amount">1</Argument>
        <Argument name="Tooltip">LOC_EMIG_POLICY_ASYLUM_EX_NAME</Argument>
        <String context="Description">LOC_EMIG_POLICY_ASYLUM_EX_DESC</String>
    </Modifier>
    <Modifier id="MOD_EMIG_ASYLUM_INFLUENCE_MO" collection="COLLECTION_OWNER" effect="EFFECT_PLAYER_ADJUST_YIELD">
        <Argument name="YieldType">YIELD_DIPLOMACY</Argument>
        <Argument name="Amount">2</Argument>
        <Argument name="Tooltip">LOC_EMIG_POLICY_ASYLUM_MO_NAME</Argument>
        <String context="Description">LOC_EMIG_POLICY_ASYLUM_MO_DESC</String>
    </Modifier>
    <Modifier id="MOD_EMIG_ASYLUM_CULTURE_MO" collection="COLLECTION_OWNER" effect="EFFECT_PLAYER_ADJUST_YIELD">
        <Argument name="YieldType">YIELD_CULTURE</Argument>
        <Argument name="Amount">1</Argument>
        <Argument name="Tooltip">LOC_EMIG_POLICY_ASYLUM_MO_NAME</Argument>
        <String context="Description">LOC_EMIG_POLICY_ASYLUM_MO_DESC</String>
    </Modifier>

    <!-- Community treatment, protective (Guest Right / Charter of Communities / Equal Protection):
         +1 / +2 / +3 Influence. The wartime payout it keeps is the JS side (emigration-treatment.js). -->
    <Modifier id="MOD_EMIG_PROTECT_INFLUENCE_AQ" collection="COLLECTION_OWNER" effect="EFFECT_PLAYER_ADJUST_YIELD">
        <Argument name="YieldType">YIELD_DIPLOMACY</Argument>
        <Argument name="Amount">1</Argument>
        <Argument name="Tooltip">LOC_EMIG_POLICY_PROTECT_AQ_NAME</Argument>
        <String context="Description">LOC_EMIG_POLICY_PROTECT_AQ_DESC</String>
    </Modifier>
    <Modifier id="MOD_EMIG_PROTECT_INFLUENCE_EX" collection="COLLECTION_OWNER" effect="EFFECT_PLAYER_ADJUST_YIELD">
        <Argument name="YieldType">YIELD_DIPLOMACY</Argument>
        <Argument name="Amount">2</Argument>
        <Argument name="Tooltip">LOC_EMIG_POLICY_PROTECT_EX_NAME</Argument>
        <String context="Description">LOC_EMIG_POLICY_PROTECT_EX_DESC</String>
    </Modifier>
    <Modifier id="MOD_EMIG_PROTECT_INFLUENCE_MO" collection="COLLECTION_OWNER" effect="EFFECT_PLAYER_ADJUST_YIELD">
        <Argument name="YieldType">YIELD_DIPLOMACY</Argument>
        <Argument name="Amount">3</Argument>
        <Argument name="Tooltip">LOC_EMIG_POLICY_PROTECT_MO_NAME</Argument>
        <String context="Description">LOC_EMIG_POLICY_PROTECT_MO_DESC</String>
    </Modifier>

    <!-- Community treatment, suspicion (Watched Quarters / Oaths of Loyalty / Registration of Residents):
         +1 / +2 / +3 Production in every city, styled on the Anti-Immigration Production modifier. The
         halved enclave payout and the fewer arrivals are the JS side. -->
    <Modifier id="MOD_EMIG_SUSPECT_PRODUCTION_AQ" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_YIELD">
        <SubjectRequirements>
            <Requirement type="REQUIREMENT_CITY_IS_CITY"/>
        </SubjectRequirements>
        <Argument name="Amount">1</Argument>
        <Argument name="YieldType">YIELD_PRODUCTION</Argument>
        <Argument name="Tooltip">LOC_EMIG_POLICY_SUSPECT_AQ_NAME</Argument>
    </Modifier>
    <Modifier id="MOD_EMIG_SUSPECT_PRODUCTION_EX" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_YIELD">
        <SubjectRequirements>
            <Requirement type="REQUIREMENT_CITY_IS_CITY"/>
        </SubjectRequirements>
        <Argument name="Amount">2</Argument>
        <Argument name="YieldType">YIELD_PRODUCTION</Argument>
        <Argument name="Tooltip">LOC_EMIG_POLICY_SUSPECT_EX_NAME</Argument>
    </Modifier>
    <Modifier id="MOD_EMIG_SUSPECT_PRODUCTION_MO" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_YIELD">
        <SubjectRequirements>
            <Requirement type="REQUIREMENT_CITY_IS_CITY"/>
        </SubjectRequirements>
        <Argument name="Amount">3</Argument>
        <Argument name="YieldType">YIELD_PRODUCTION</Argument>
        <Argument name="Tooltip">LOC_EMIG_POLICY_SUSPECT_MO_NAME</Argument>
    </Modifier>
</GameEffects>
